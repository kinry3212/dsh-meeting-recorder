{
  "name": "dsh-meeting-recorder",
  "version": "0.1.0",
  "description": "DSH 会议记录插件：长会话中随时可查的脉络清单，独立模型、可开关、能续接补记",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinry3212/dsh-meeting-recorder.git"
  },
  "homepage": "https://github.com/kinry3212/dsh-meeting-recorder#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "meeting-notes",
    "session-summary"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
